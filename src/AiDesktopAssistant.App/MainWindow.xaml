<Window x:Class="AiDesktopAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:AiDesktopAssistant.App.Behaviors"
        mc:Ignorable="d"
        Title="AI Desktop Assistant" Height="720" Width="1120"
        MinHeight="520" MinWidth="860">
    <Grid Background="#F5F6F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1F2937" Padding="16">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="Conversations"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16" />
                <ListBox ItemsSource="{Binding Conversations}"
                         SelectedItem="{Binding SelectedConversation}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:g}}"
                                           Opacity="0.72"
                                           FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Local Ollama Chat"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#111827" />
                <TextBlock Text="Press Ctrl+Alt+Space from any app to open the assistant and copy selected text into the prompt context."
                           Foreground="#4B5563"
                           Margin="0,4,0,0" />
            </StackPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Messages}"
                     behaviors:ListBoxScrollBehavior.AutoScrollToEnd="True"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,14"
                                Padding="14"
                                Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{Binding RoleLabel}"
                                           FontWeight="Bold"
                                           Foreground="#374151"
                                           Margin="0,0,0,8" />

                                <Expander Header="Reasoning / thinking"
                                          Visibility="{Binding HasReasoning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          Margin="0,0,0,10"
                                          IsExpanded="False">
                                    <TextBlock Text="{Binding ReasoningContent}"
                                               TextWrapping="Wrap"
                                               FontFamily="Consolas"
                                               Foreground="#6B7280"
                                               Margin="0,8,0,0" />
                                </Expander>

                                <TextBlock Text="{Binding Content}"
                                           TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           FontSize="14"
                                           Foreground="#111827" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2"
                    Margin="0,14,0,0"
                    Padding="12"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="82"
                             FontFamily="Consolas"
                             FontSize="14"
                             BorderThickness="0" />

                    <Button Grid.Column="1"
                            Content="Send"
                            Command="{Binding SendCommand}"
                            Width="112"
                            Height="42"
                            Margin="12,0,0,0"
                            VerticalAlignment="Bottom" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
