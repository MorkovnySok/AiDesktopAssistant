<Window x:Class="AiDesktopAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:AiDesktopAssistant.App.Behaviors"
        xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml"
        mc:Ignorable="d"
        Title="AI Desktop Assistant" Height="720" Width="1120"
        MinHeight="520" MinWidth="860">
    <Window.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#374151" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#4B5563" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="DangerSidebarButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="#7F1D1D" />
            <Setter Property="BorderBrush" Value="#991B1B" />
        </Style>

        <Style x:Key="MessageMarkdownStyle" TargetType="{x:Type mdxam:MarkdownScrollViewer}">
            <Setter Property="IsToolBarVisible" Value="False" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Background="#F5F6F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1F2937" Padding="16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Conversations"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="New chat"
                                Command="{Binding NewConversationCommand}"
                                Style="{StaticResource SidebarButtonStyle}" />
                        <Button Grid.Column="2"
                                Content="Delete"
                                Command="{Binding DeleteConversationCommand}"
                                Style="{StaticResource DangerSidebarButtonStyle}" />
                    </Grid>
                </StackPanel>
                <ListBox ItemsSource="{Binding Conversations}"
                         SelectedItem="{Binding SelectedConversation}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:g}}"
                                           Opacity="0.72"
                                           FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Local Ollama Chat"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#111827" />
                <TextBlock Text="Streaming responses with separate thinking/reasoning support."
                           Foreground="#4B5563"
                           Margin="0,4,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          behaviors:ScrollViewerScrollBehavior.AutoScrollToEnd="True"
                          CanContentScroll="False"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="{x:Type ContentPresenter}">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,14"
                                    Padding="14"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding RoleLabel}"
                                               FontWeight="Bold"
                                               Foreground="#374151"
                                               Margin="0,0,0,8" />

                                    <Expander Header="Reasoning / thinking"
                                              Visibility="{Binding HasReasoning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Margin="0,0,0,10"
                                              HorizontalContentAlignment="Stretch"
                                              IsExpanded="False">
                                        <TextBlock Text="{Binding ReasoningContent}"
                                                   TextWrapping="WrapWithOverflow"
                                                   FontFamily="Consolas"
                                                   Foreground="#6B7280"
                                                   Margin="0,8,0,0" />
                                    </Expander>

                                    <mdxam:MarkdownScrollViewer Markdown="{Binding Content}"
                                                                Style="{StaticResource MessageMarkdownStyle}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Margin="0,14,0,0"
                    Padding="12"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                             behaviors:TextBoxInputBehavior.SubmitCommand="{Binding SendCommand}"
                             behaviors:TextBoxInputBehavior.MoveCaretToEndSignal="{Binding MoveInputCaretToEndSignal}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="82"
                             FontFamily="Consolas"
                             FontSize="14"
                             BorderThickness="0" />

                    <Button Grid.Column="1"
                            Content="Send"
                            Command="{Binding SendCommand}"
                            Width="112"
                            Height="42"
                            Margin="12,0,0,0"
                            VerticalAlignment="Bottom" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
