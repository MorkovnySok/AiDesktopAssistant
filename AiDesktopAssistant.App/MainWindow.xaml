<Window x:Class="AiDesktopAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AiDesktopAssistant"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="ChatMessages"
                 Grid.Row="0"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,12"
                            Padding="10"
                            BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="{Binding Role}"
                                       FontWeight="Bold"
                                       Margin="0,0,0,4" />

                            <TextBlock Text="{Binding Content}"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas"
                                       FontSize="14" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBox Grid.Row="1" Margin="0,12,0,8" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" AcceptsReturn="True" x:Name="UserInput" />
        <Button Grid.Row="2" Content="Send" Height="36" Click="SendButtonClick" Width="120" HorizontalAlignment="Right" />
    </Grid>
</Window>